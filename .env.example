# Copy to .env for local development. EXPO_PUBLIC_* values are bundled into
# the shipped app and are PUBLIC — nothing secret may ever use this prefix.
#
# Secrets that must NEVER appear here or anywhere under src/ or app/:
#   SENTRY_AUTH_TOKEN          -> EAS Secrets only (sourcemap upload)
#   REVENUECAT_WEBHOOK_SECRET  -> Supabase Edge Function secrets only
#   SUPABASE_SERVICE_ROLE_KEY  -> Supabase Edge Function secrets only

# Supabase project URL (local dev: http://127.0.0.1:54321 after `supabase start`)
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon key — public by design; Row Level Security is the real gate
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat public Android SDK key (starts with `goog_`)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Sentry DSN — public identifier, not a secret
EXPO_PUBLIC_SENTRY_DSN=
