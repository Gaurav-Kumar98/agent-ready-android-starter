{
  "name": "expo-android-template",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "//@emnapi": "@emnapi/core and @emnapi/runtime are devDependencies nothing imports. They are peer deps of @napi-rs/wasm-runtime, reached only through the optional wasm fallback binding that ESLint's resolver pulls in. npm on Linux expects them in package-lock.json; npm on Windows declines to write them, so `npm ci` fails on CI against a lock generated on Windows. Declaring them explicitly keeps the lockfile identical on every platform. Remove them only if `npm ci` still passes on Linux.",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "start": "expo start --dev-client",
